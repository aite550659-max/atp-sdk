# ATP Rental Container — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Required: Anthropic API key for the rental agent (Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Required: Telegram bot token — @ATPRentalBot (SEPARATE from owner's @TExplorer59bot)
TELEGRAM_BOT_TOKEN=1234567890:ABC...

# Required: Brave Search API key
BRAVE_API_KEY=BSA...

# Optional: Gateway auth token (auto-generated if not set)
GATEWAY_TOKEN=

# Optional: Webhook URL for breach alerts (owner receives these)
BREACH_ALERT_URL=

# Optional: HCS sidecar config (if running sidecar in same container)
HEDERA_OPERATOR_ID=0.0.10255397
HEDERA_OPERATOR_KEY=
HCS_TOPIC_ID=0.0.10272696
