# ATP HCS Sidecar — Polls rental agent session, logs to Hedera
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl cron \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash sidecar
USER sidecar
WORKDIR /home/sidecar

# Install Hedera SDK
RUN npm init -y && npm install @hashgraph/sdk

# Copy sidecar scripts
COPY --chown=sidecar:sidecar scripts/rental-sidecar.mjs /home/sidecar/rental-sidecar.mjs
COPY --chown=sidecar:sidecar scripts/rental-status.mjs  /home/sidecar/rental-status.mjs
COPY --chown=sidecar:sidecar scripts/rental-kill.mjs    /home/sidecar/rental-kill.mjs
COPY --chown=sidecar:sidecar docker/sidecar-entrypoint.sh /home/sidecar/entrypoint.sh

USER root
RUN chmod +x /home/sidecar/entrypoint.sh
USER sidecar

ENTRYPOINT ["/home/sidecar/entrypoint.sh"]
