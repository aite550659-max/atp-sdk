{
  "name": "agent-trust-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "ATP local runtime and reference implementation for verifiable agent rental flows on Hedera",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"No root test suite configured yet\" && exit 0",
    "atp:setup": "node scripts/atp-setup.mjs",
    "atp:doctor": "node scripts/atp-doctor.mjs",
    "atp:doctor:json": "node scripts/atp-doctor.mjs --json",
    "atp:docker:build": "cd docker && docker build -t atp-rental .",
    "atp:relay": "node packages/val-relay/src/server.mjs",
    "atp:monitor": "node monitor/atp-monitor.mjs",
    "atp:watcher": "node monitor/deposit-watcher.mjs --daemon",
    "atp:test:rental": "node scripts/rental-test.mjs"
  },
  "keywords": [
    "atp",
    "agent-trust-protocol",
    "hedera",
    "agent-rental",
    "hcs",
    "hts"
  ],
  "author": "Gregg Bell, Aite",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aite550659-max/agent-trust-protocol.git"
  },
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@hashgraph/sdk": "^2.80.0",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@solana/web3.js": "^1.98.4",
    "@xenova/transformers": "^2.17.2",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "coinbase-sdk": "^1.3.2",
    "ecpair": "^3.0.1",
    "ed25519-hd-key": "^1.3.0",
    "googleapis": "^171.2.0",
    "tiny-secp256k1": "^2.2.4",
    "viem": "^2.46.3"
  },
  "devDependencies": {
    "solc": "^0.8.33"
  }
}
